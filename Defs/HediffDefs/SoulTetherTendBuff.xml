<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Transient hediff granted to the target of a successful Soul Tether pull
       (research.md R6 of specs/017-soul-tether-tattoo-effect). Not player-
       configured via XML — the actual quality/speed magnitudes and duration
       are resolved through TattooEffectValues at grant time and set directly
       on the comp instance (HediffComp_SoulTetherTendBuff.Configure,
       HediffComp_Disappears.SetDuration), not read from HediffStage. Unlike
       Frost Sigil's slow, this hediff is helpful (isBad = false). -->
  <HediffDef>
    <defName>TattooMagic_Hediff_SoulTetherTendBuff</defName>
    <label>soul-tethered</label>
    <description>Recently pulled to safety by a Soul Tether tattoo — easier to tend, faster and better.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="TattooMagic.HediffCompProperties_SoulTetherTendBuff" />
    </comps>
  </HediffDef>

</Defs>
