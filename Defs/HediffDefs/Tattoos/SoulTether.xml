<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <HediffDef>
    <defName>TattooMagic_Hediff_SoulTether</defName>
    <label>soul tether tattoo</label>
    <description>A magic tattoo granting a triggered ability to pull a chosen friendly pawn (or their corpse) to the wearer, granting a tend speed/quality buff on arrival.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="TattooMagic.HediffCompProperties_SoulTetherEffect">
        <!-- Placeholder values pending the PRD §9 balance pass; small/fast-to-test per feature 006 research.md R8. -->
        <rangeTier1>10</rangeTier1>
        <rangeTier2>16</rangeTier2>
        <cooldownDurationTicks>1800</cooldownDurationTicks>
        <tier2Threshold>15</tier2Threshold>
        <tendQualityBonusTier1>0.15</tendQualityBonusTier1>
        <tendQualityBonusTier2>0.30</tendQualityBonusTier2>
        <tendSpeedBonusTier1>0.5</tendSpeedBonusTier1>
        <tendSpeedBonusTier2>1.0</tendSpeedBonusTier2>
        <tendBuffDurationTicks>1800</tendBuffDurationTicks>
        <!-- Quick "grab" window before the target actually arrives (2026-09-19 addendum) - kept short so this reads as a snatch, not a slow float. -->
        <pullEffectDurationTicks>20</pullEffectDurationTicks>
        <abilityIconPath>UI/Commands/SoulTether</abilityIconPath>
      </li>
    </comps>
  </HediffDef>

</Defs>
