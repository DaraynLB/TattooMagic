<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- All numeric values below are placeholders pending the PRD §9 balance
       pass. They are read exclusively through TattooEffectValues at point of
       use (FR-011) — the values here only ever serve as that accessor's
       xmlDefault argument. -->
  <HediffDef>
    <defName>TattooMagic_Hediff_SerpentsEye</defName>
    <label>serpent's eye tattoo</label>
    <description>A magic tattoo granting increased accuracy and (with Combat Extended) reduced weapon sway/recoil. Grows stronger with use, eventually boosting ammo effectiveness under Combat Extended.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="TattooMagic.HediffCompProperties_SerpentsEyeEffect">
        <accuracyBonusTier1>0.05</accuracyBonusTier1>
        <accuracyBonusTier2>0.1</accuracyBonusTier2>
        <swayRecoilBonusTier1>0.05</swayRecoilBonusTier1>
        <swayRecoilBonusTier2>0.1</swayRecoilBonusTier2>
        <ceAmmoEffectivenessMultiplierTier2>1.15</ceAmmoEffectivenessMultiplierTier2>
        <tier2Threshold>15</tier2Threshold>
      </li>
    </comps>
  </HediffDef>

</Defs>
