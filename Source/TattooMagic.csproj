<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dual build: net472 for RimWorld 1.6 (Unity/Mono), net10.0 for RimWorld 1.7
       (Waylith engine, .NET 10 CLR). One `dotnet build` produces both DLLs;
       LoadFolders.xml picks the right one per game version. Drop the net472
       target once 1.7 reaches Steam's main branch. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TattooMagic</RootNamespace>
    <AssemblyName>TattooMagic</AssemblyName>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Avoids stray .pdb files that can trip up RimWorld's assembly loader -->
    <DebugType>none</DebugType>

    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Build output lands directly in each version's Assemblies folder -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputPath>..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <!-- .NET Core builds emit a .deps.json; RimWorld doesn't need it -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony, for patching game methods. Compile-time only: the Harmony
         mod (a hard dependency in About.xml) supplies the right 0Harmony.dll
         for each game version at runtime. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Auto-references the game's own DLLs, per game version. If it can't find
       the install automatically, uncomment RimWorldPath below. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4984-unstable" />
  </ItemGroup>

  <!--
  <PropertyGroup>
    <RimWorldPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>
  -->

  <PropertyGroup>
    <RimWorldModsPath Condition="'$(RimWorldModsPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods</RimWorldModsPath>
    <ModPublishDir>$(RimWorldModsPath)\$(AssemblyName)</ModPublishDir>
  </PropertyGroup>

  <!-- Runs once after both target frameworks have built (outer build), not per framework -->
  <Target Name="PublishToModsFolder" AfterTargets="Build" Condition="'$(TargetFramework)' == ''">
    <ItemGroup>
      <AboutFiles Include="$(ProjectDir)..\About\**\*.*" />
      <V16Files Include="$(ProjectDir)..\1.6\**\*.*" />
      <V17Files Include="$(ProjectDir)..\1.7\**\*.*" />
      <DefsFiles Include="$(ProjectDir)..\Defs\**\*.*" />
      <TextureFiles Include="$(ProjectDir)..\Textures\**\*.*" />
      <PatchesFiles Include="$(ProjectDir)..\Patches\**\*.*" />
      <LanguagesFiles Include="$(ProjectDir)..\Languages\**\*.*" />
    </ItemGroup>
    <!-- A root-level Assemblies/ would load on every game version alongside the
         versioned DLL; remove any left over from the pre-dual-build layout. -->
    <RemoveDir Directories="$(ModPublishDir)\Assemblies" />
    <Copy SourceFiles="$(ProjectDir)..\LoadFolders.xml" DestinationFolder="$(ModPublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(ModPublishDir)\About\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(V16Files)" DestinationFolder="$(ModPublishDir)\1.6\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(V17Files)" DestinationFolder="$(ModPublishDir)\1.7\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DefsFiles)" DestinationFolder="$(ModPublishDir)\Defs\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TextureFiles)" DestinationFolder="$(ModPublishDir)\Textures\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PatchesFiles)" DestinationFolder="$(ModPublishDir)\Patches\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LanguagesFiles)" DestinationFolder="$(ModPublishDir)\Languages\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
